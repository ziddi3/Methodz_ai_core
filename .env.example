# Methodz AI Core — shared AI infrastructure
# Existing provider configuration
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Provider router also supports these existing runtime keys
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Nexus read-only narration
# When METHODZ_NARRATION_TOKEN is set, /api/narrate requires
# X-Methodz-Narration-Token. Prefer calling it from a server-side Nexus route,
# not exposing this token in browser JavaScript.
METHODZ_NARRATION_TOKEN=
# Optional comma-separated preview origins in addition to *.methodz.ca and localhost.
NARRATION_ALLOWED_ORIGINS=
